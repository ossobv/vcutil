#!/usr/bin/env python3
# apt-find-depchain (part of ossobv/vcutil) // wdoekes/2026 // Public Domain
#
# Lists all installed packages that depend, directly or transitively, on
# the given packages. Only hard dependencies (Depends, Pre-Depends) are
# followed; Recommends, Suggests, Conflicts, Breaks, Replaces and Enhances
# are ignored. The chain is only followed through installed packages.
#
# Use this to find out what keeps a package installed, or what would go
# (or would be replaced) if you removed it. (Packages listing PACKAGE only
# as an alternative ("a | b") are included too, even if the other
# alternative would satisfy them.)
#
# Usage:
#
#   apt-find-depchain [-v] [-d DEPTH] [-t PACKAGE] PACKAGE...
#
# Example:
#
#   $ apt-find-depchain libpython3.12
#   libpython3.12-stdlib
#   python3.12
#   ...
#
# Use -v to show the direct dependencies and -d to limit the dependency depth.
#
# Use -t to show (trace) a dependency chain for one or more packages:
#
#   $ apt-find-depchain libbrotli1 -t grub-efi-amd64-bin -t zabbix-agent
#   grub-efi-amd64-bin -> grub-common -> libfreetype6 -> libbrotli1
#   zabbix-agent -> libcurl3-gnutls -> libbrotli1
#   zabbix-agent -> libcurl4 -> libbrotli1
#
import argparse
import sys
from collections import defaultdict
from subprocess import CalledProcessError, check_output


def check_english_output(command, **kwargs):
    assert 'env' not in kwargs, kwargs
    # Wipe all of LANG, LC_ALL, LC_MESSAGES to get C locale.
    return check_output(command, env={}, **kwargs).decode('utf-8')


def get_all_installed_rdepends(packages):
    options = [
        '--installed', '--recurse',
        '--no-recommends', '--no-suggests', '--no-conflicts',
        '--no-breaks', '--no-replaces', '--no-enhances',
        '--']
    data = check_english_output(['apt-cache', 'rdepends'] + options + packages)
    lines = data.splitlines()

    idx, maxidx = 0, len(lines)
    deps_by = defaultdict(set)
    while idx < maxidx:
        package = lines[idx + 0]
        assert ' ' not in package and ':' not in package, lines[idx:(idx + 4)]
        assert lines[idx + 1] == 'Reverse Depends:', lines[idx:(idx + 4)]
        idx += 2
        while idx < maxidx and lines[idx].startswith(('  ', ' |')):  # dep-OR
            if lines[idx].startswith('    '):
                pass  # Provides
            else:
                dep = lines[idx][2:]  # no ":amd64" suffix here
                assert dep == dep.strip(), dep
                deps_by[dep].add(package)
            idx += 1

    return deps_by


def by_depth(roots, deps_for):
    seen = set(roots)
    level = roots
    while True:
        level = set(
            dep for dep, causes in deps_for.items()
            if dep not in seen and not causes.isdisjoint(level))
        if not level:
            break
        seen |= level
        yield level


def trace_dependencies(package, roots, deps_for, maxdepth=None):
    path = [package]

    def walk():
        pkg = path[-1]
        if pkg in roots:
            yield tuple(path)
        elif not maxdepth or len(path) <= maxdepth:
            for cause in sorted(deps_for[pkg]):
                if cause not in path:
                    path.append(cause)
                    yield from walk()
                    path.pop()

    return walk()


def main():
    parser = argparse.ArgumentParser(
        prog='apt-find-depchain',
        description=(
            'Lists all installed packages that depend, directly or '
            'transitively, on the given packages. Use this to list packages '
            'that would be removed/replaced when uninstalling a package.'))
    parser.add_argument(
        '-d', '--depth', action='store', type=int, help=(
            'Stop at depth DEPTH. Use in combination with -v. '
            '0 means infinite.'))
    parser.add_argument(
        '-t', '--trace', metavar='PACKAGE', action='append', help=(
            'Show all dependency paths from PACKAGE to the given packages. '
            'Use -d to limit the path length.'))
    parser.add_argument(
        '-v', '--verbose', action='store_true', help=(
            'Show dependent packages and dependency depth.'))
    parser.add_argument(
        'package', nargs='+', help=(
            'Package name to check dependencies for.'))
    try:
        args = parser.parse_intermixed_args()
    except AttributeError:
        args = parser.parse_args()

    packages_to_check = list(sorted(args.package))
    try:
        deps_for = get_all_installed_rdepends(packages_to_check)
    except CalledProcessError as e:
        print('error: {}'.format(e), file=sys.stderr)
        sys.exit(1)

    if args.trace:
        trace_args = list(sorted(set(args.trace)))
        fail = False
        for trace in trace_args:
            if trace not in deps_for:
                print('error: no {} installed that depends on {}'.format(
                    trace, ' '.join(packages_to_check)))
                fail = True
        if fail:
            sys.exit(1)

        for trace in trace_args:
            paths = trace_dependencies(
                trace, set(packages_to_check), deps_for, args.depth)
            for path in sorted(paths, key=len):
                print(' -> '.join(path))

    elif args.depth is None and not args.verbose:
        for dep in sorted(deps_for.keys()):
            print(dep)

    elif not args.verbose:
        deps_per_level = by_depth(packages_to_check, deps_for)
        all_deps = set()
        for depth, deps in enumerate(deps_per_level, 1):
            if args.depth and depth > args.depth:
                break
            all_deps.update(deps)
        for dep in sorted(all_deps):
            print(dep)

    else:
        deps_per_level = by_depth(packages_to_check, deps_for)
        for depth, deps in enumerate(deps_per_level, 1):
            if args.depth and depth > args.depth:
                break
            print('#{}'.format(depth))
            for dep in sorted(deps):
                print('{:32s}  {}'.format(
                    dep, ' '.join(sorted(deps_for[dep]))))
            print()


if __name__ == '__main__':
    main()
