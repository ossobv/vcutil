def build_argparser():
    p = ArgumentParser(
        prog='renum',
        formatter_class=RawTextHelpFormatter,
        description=(
            'Replace numeric codes (errno, syscall, etc.) with symbolic '
            'names,\n'
            'based on mapping rules: re(verse-e)num.\n'
            '\n'
            'Common usage is enriching bpftrace(8) @map output:\n'
            '\n'
            '  bpftrace -e \'\n'
            '    tracepoint:raw_syscalls:sys_exit {\n'
            '      if (args->id < 0) { @by_errno[-args->id] = count(); }\n'
            '    }\n'
            '    interval:s:5 {\n'
            '      print("---"); print(@by_errno); clear(@by_errno);\n'
            '    }\'\n'
            '\n'
            'This outputs these numeric constants:\n'
            '\n'
            '  ---\n'
            '  @by_errno[512]: 3\n'
            '  @by_errno[13]: 16\n'
            '  @by_errno[11]: 17938\n'
            '  @by_errno[2]: 70107\n'
            '\n'
            'Piping through "renum errno,^@by_errno" gives the constants a '
            'symbolic name:\n'
            '\n'
            '  ---\n'
            '  @by_errno[512]: 3\n'
            '  @by_errno[EACCES (13)]: 16\n'
            '  @by_errno[EAGAIN (11)]: 17938\n'
            '  @by_errno[ENOENT (2)]: 70107\n'))
    p.add_argument(
        'rules',
        metavar='RULE',
        type=Rule,
        nargs='+',
        help=(
            'Mapping rule(s) in the form '
            '"field=map[,field=map,...[,^regex]]".\n'
            'Examples:\n'
            '  renum "1=errno,2=syscall,^@by_syscall_errno"\n'
            '  renum "s,e,^@"\n'
            '  renum "1=e,^@by_errno" "1=s,^@by_syscall"\n'
            '\n'
            'Shorthand maps: e=errno, s=syscall, sig=signal.\n'
            'Regex must start with "^" if given.\n'
            '\n'
            'Only the first matching rule will be used, so you need regexes\n'
            'for all rules except the last.'))

    return p


class Rule:
    FIELD_ALIASES = {
        # Names
        'errno': 'errno',
        'signal': 'signal',
        'syscall': 'syscall',
        # Aliases
        'e': 'errno',
        'sig': 'signal',
        's': 'syscall',
    }

    def __init__(self, fmt):
        """
        Decode fmt [field=]map[,[field=]map][,^filter] to mappings and regex
        """
        replace_maps = {}
        replace_maps_nextidx = 1
        filter_re = None

        parts = fmt.split(',')
        for idx, part in enumerate(parts):
            if part.startswith('^'):
                filter_re = re_compile(','.join(parts[idx:]))
                break

            if '=' in part:
                field, map_ = part.split('=', 1)
                field = int(field)
            else:
                field = replace_maps_nextidx
                map_ = part

            if map_ not in self.FIELD_ALIASES:
                raise ValueError(f'unexpected map name {map_}')

            replace_maps[field] = self.FIELD_ALIASES[map_]
            replace_maps_nextidx = field + 1

        self.replace_maps = replace_maps
        self.filter_re = filter_re

    def select_map(self, map_):
        for field, map_name in self.replace_maps.items():
            self.replace_maps[field] = map_[map_name]


class RuleTestCase(TestCase):
    def test_fmt_basic(self):
        rule = Rule('4=syscall,2=errno,3=signal')
        self.assertIsNone(rule.filter_re)
        self.assertEqual(rule.replace_maps, {
            4: 'syscall', 2: 'errno', 3: 'signal'})

    def test_fmt_no_field(self):
        rule = Rule('syscall,signal,errno')
        self.assertIsNone(rule.filter_re)
        self.assertEqual(rule.replace_maps, {
            1: 'syscall', 2: 'signal', 3: 'errno'})

    def test_fmt_one_field_then_continue_counting(self):
        rule = Rule('3=syscall,signal,errno')
        self.assertIsNone(rule.filter_re)
        self.assertEqual(rule.replace_maps, {
            3: 'syscall', 4: 'signal', 5: 'errno'})

    def test_fmt_one_field_then_continue_counting_2(self):
        rule = Rule('syscall,5=signal,errno')
        self.assertIsNone(rule.filter_re)
        self.assertEqual(rule.replace_maps, {
            1: 'syscall', 5: 'signal', 6: 'errno'})

    def test_fmt_regex(self):
        rule = Rule('^@')
        self.assertEqual(rule.filter_re, re_compile('^@'))
        self.assertEqual(rule.replace_maps, {})

    def test_fmt_shorthand_and_regex(self):
        rule = Rule('s,e,^@by_syscall_errno')
        self.assertEqual(rule.filter_re, re_compile('^@by_syscall_errno'))
        self.assertEqual(rule.replace_maps, {
            1: 'syscall', 2: 'errno'})

    def test_fmt_illegal(self):
        with self.assertRaises(ValueError):
            Rule('bad_name')
        with self.assertRaises(ValueError):
            Rule('s,e,b')  # b does not exist
        with self.assertRaises(ValueError):
            Rule(',e,^@missing_first_value')
        with self.assertRaises(ValueError):
            Rule('s,,^@missing_second_value')
        with self.assertRaises(ValueError):
            Rule('s,')
        with self.assertRaises(ValueError):
            Rule('s,=e')
        with self.assertRaises(ValueError):
            Rule('')


class Replacer:
    """
    Callable that replaces numbers with names.

    It counts how often it is called and selects the first map based on
    the call count. Selects the second map based on the value of
    match_.group(0).
    """
    def __init__(self, maps):
        """
        Takes a map of maps. For example: {1: SYSCALLS, 3: ERRNO}

        The first match would use the SYSCALLS for replacement, the
        third match would use ERRNO. Non-matched items will be returned
        verbatim.
        """
        self._maps = maps
        self._int_position = 0

    def __call__(self, match_):
        """
        Takes a re.Match object, converts to integer, looks up replacement
        table and returns replacement if found.
        """
        self._int_position += 1

        orig = match_.group(0)
        symbol_map = self._maps.get(self._int_position)
        if symbol_map:
            num = int(orig)
            symbol = symbol_map.get(num)
            if symbol:
                return f'{symbol} ({num})'

        return orig


class ReplacerTestCase(TestCase):
    def test_replacer(self):
        map_ = {3: {5: 'foo', 15: 'bar'}, 5: {5: 'FOO', 15: 'BAR'}}
        re = re_compile(r'\b\d+\b')
        self.assertEqual(
            re.sub(Replacer(map_), '1-2'),
            '1-2')
        self.assertEqual(
            re.sub(Replacer(map_), '1-2-3'),
            '1-2-3')
        self.assertEqual(
            re.sub(Replacer(map_), '1-2-5'),
            '1-2-foo (5)')
        self.assertEqual(
            re.sub(Replacer(map_), '1-2-15-4-5-6'),
            '1-2-bar (15)-4-FOO (5)-6')


def main():
    argparser = build_argparser()
    args = argparser.parse_args()

    rules = args.rules
    for rule in rules:
        rule.select_map(FIELDS)

    # Regex to find/replace all integers
    int_re = re_compile(r'\b\d+\b')

    for line in sys.stdin:
        for rule in rules:
            if rule.filter_re is None:
                break  # no regex? then we use this rule
            if rule.filter_re.search(line):
                break  # match! we use this rule
        else:
            rule = None  # no match? no replacements

        if rule:
            line = int_re.sub(Replacer(rule.replace_maps), line)

        print(line, end='')


