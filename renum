#!/usr/bin/env python
# renum (part of ossobv/vcutil) // wdoekes/2025 // Public Domain
#
# Replace numeric codes (errno, syscall, etc.) with symbolic names,
# based on mapping rules: reverse-enum.
#
# You can quickly look up errno or a syscall number, using:
#
#   $ renum errno <<<'1'
#   EPERM (1)
#
#   $ renum syscall <<<'1'
#   write (1)
#
# But more useful is to post-process values from somewhere else. For
# instance you might have a bpftrace(8) program that outputs various
# counts of errno, syscall numbers or a combination of the two:
#
#   @errno[1] = 5
#   @syscall[1] = 7
#   @syscall_errno[1, 1] = 9
#
# If you pipe that through renum as follows:
#
#   renum \
#     1=syscall,2=errno,^@syscall_errno \
#     1=errno,^@errno \
#     1=syscall,^@syscall
#
# or, using the shorthand form:
#
#   renum s,e,^@syscall_errno e,^@errno s,^@syscall
#
# you will see this:
#
#   @errno[EPERM (1)] = 5
#   @syscall[write (1)] = 7
#   @syscall_errno[write (1), EPERM (1)] = 9
#
# (Note how the "^@syscall_errno" regex needs to be before "^@syscall", or
# the latter would match first.)
#
# See also: ausyscall(8) in the auditd package.
#
