#!/usr/bin/env python3
# _multi2json (part of ossobv/vcutil) // wdoekes/2026 // Public Domain
#
# Convert various serialized formats to json. Mainly useful when dealing
# with Python repr() output or with sloppy Rust Debug representations.
#
# For example this hypothetical information about cluster D:
#
# $ D="{'cluster': 'c1', 'nodes': [2, 4, 5]}"  # a Python REPR string
#
# If we want to do something with it, we'll want it converted to JSON:
#
# $ echo "$D" | 2json.py
# {
#   "cluster": "c1",
#   "nodes": [
#     2,
#     4,
#     5
#   ]
# }
#
# Since it was easy, the tool also has ".yaml" and ".js" versions.
#
# Currently implemented:
# - 2json.js <-- indents JSON
# - 2json.py <-- parses Python repr()
# - 2json.rs <-- reads Rust-like curly bracket representation and writes JSON
# - 2json.yaml <- converts YAML to JSON
#
import json
import os.path
import sys

from unittest import TestCase, main as unittest_main


